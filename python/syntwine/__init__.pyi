from collections.abc import Callable, Iterable, Mapping, Sequence, Sized
from typing import Any, Concatenate, Protocol, Self, TypedDict, overload
from typing import Literal as _L

from . import telemetry as telemetry
from .telemetry import TelemetryConfig, Trace
from .typing import (
    BuildContext,
    MarkdownHeading,
    MarkdownLink,
    MarkdownSection,
    Parser,
    PathArgument,
    Serializer,
    Validator,
)
from .typing import (
    JSONValue as JSONValue,
)
from .typing import (
    TOMLTable as TOMLTable,
)
from .typing import (
    TOMLValue as TOMLValue,
)

type _Cache = _L["session", "none"]
type _Conflict = _L["left", "right", "error"]
type _Newline = _L["lf", "crlf", "cr"]
type _DocumentFormat = _L["text", "raw", "md", "markdown", "json", "toml", "xml"]
type _SquishMode = _L["auto", "text", "raw", "md", "markdown", "json", "toml", "xml"]
type _DocumentPart = Source[Any] | str | bytes
type _TextOperand = str | Source[str]
type _BytesOperand = bytes | Source[bytes]
type _SourceKey = str | Source[str]
type _JSONKey = str | int | Source[str] | Source[int]
type _TOMLTableOperand = dict[str, Any] | Source[dict[str, Any]]
type _MarkdownOperand = str | Source[Any]
type _XMLOperand = str | bytes | Source[Any]

class _Tokenizer(Protocol):
    def encode(self, value: str, /) -> Sized: ...

type _TokenizerSpec = str | Callable[[str], int | Sized] | _Tokenizer

class _Dependency(TypedDict):
    node_id: int
    operation: str
    source_id: str

class _Node(_Dependency):
    kind: str
    dependencies: list[int]
    pure: bool

class _Graph(TypedDict):
    root: int
    nodes: list[_Node]

class SyntwineError(Exception):
    source_id: str | None
    operation: str | None
    dependency_path: list[_Dependency]
    location: str | None
    cause: BaseException | None
    trace_id: str | None
    trace: Trace | None

class SourceError(SyntwineError): ...
class DecodeError(SyntwineError): ...
class EncodingError(SyntwineError): ...
class ParseError(SyntwineError): ...
class TypeMismatch(SyntwineError): ...
class CycleError(SyntwineError): ...
class OperationError(SyntwineError): ...
class OperationConflict(SyntwineError): ...
class SerializationError(SyntwineError): ...
class EvaluationLimit(OperationError): ...

class BudgetExceeded(SyntwineError):
    dimension: _L["characters", "bytes", "tokens"]
    actual: int
    budget: int
    overage: int
    sources: Sequence[str]

class Budget:
    def __init__(
        self,
        *,
        characters: int | None = ...,
        bytes: int | None = ...,
        tokens: int | None = ...,
    ) -> None: ...
    @property
    def characters(self) -> int | None: ...
    @property
    def bytes(self) -> int | None: ...
    @property
    def tokens(self) -> int | None: ...

class Usage:
    @property
    def characters(self) -> int | None: ...
    @property
    def bytes(self) -> int: ...
    @property
    def tokens(self) -> int | None: ...

class BuildOptions:
    def __init__(
        self,
        *,
        cache: _Cache = "session",
        max_nodes: int = 100_000,
        max_depth: int = 512,
    ) -> None: ...
    @property
    def cache(self) -> _Cache: ...
    @property
    def max_nodes(self) -> int: ...
    @property
    def max_depth(self) -> int: ...

class Generated[T]:
    @property
    def bytes(self) -> bytes: ...
    @property
    def text(self) -> str: ...
    @property
    def value(self) -> T: ...
    @property
    def usage(self) -> Usage: ...
    @property
    def sources(self) -> Sequence[str]: ...
    @property
    def trace(self) -> Trace | None: ...

class Source[T]:
    def __init__(self: Source[bytes], path: PathArgument) -> None: ...
    @staticmethod
    def path(path: PathArgument) -> Source[bytes]: ...
    @classmethod
    def from_value[U](cls, value: U) -> Source[U]: ...
    @overload
    @staticmethod
    def defer[U](
        fn: Callable[[BuildContext], Source[U]], *, pure: bool = True
    ) -> Source[U]: ...
    @overload
    @staticmethod
    def defer[U](
        fn: Callable[[BuildContext], U], *, pure: bool = True
    ) -> Source[U]: ...
    def as_literal(self) -> Literal: ...
    def as_text(self, encoding: str = "utf-8") -> Text: ...
    def as_md(self) -> MD: ...
    def as_toml(self) -> TOML: ...
    def as_json(self) -> JSON: ...
    def as_xml(self) -> XML: ...
    def as_format[S: Source[Any]](self, cls: type[S]) -> S: ...
    def codeblock(self, language: str = "") -> MD: ...
    @overload
    def pipe[U, S: Source[Any]](
        self, op: Operation[T, ..., U, S], *args: object, **kwargs: object
    ) -> S: ...
    @overload
    def pipe[U](self, op: Callable[[T], U]) -> Source[U]: ...
    @overload
    def pipe[U](
        self, op: Callable[Concatenate[T, ...], U], *args: object, **kwargs: object
    ) -> Source[U]: ...
    @overload
    def pipe(self, op: str, *args: object, **kwargs: object) -> Source[Any]: ...
    def op(self, name: str, *args: object, **kwargs: object) -> Source[Any]: ...
    def map[U](self, fn: Callable[[T], U], *, pure: bool = True) -> Source[U]: ...
    def bind[U](
        self, fn: Callable[[T], Source[U]], *, pure: bool = True
    ) -> Source[U]: ...
    def zip[U](self, other: Source[U]) -> Source[tuple[T, U]]: ...
    def combine[U](self, *others: Source[Any], fn: Callable[..., U]) -> Source[U]: ...
    def require(
        self, predicate: Callable[[T], bool], message: str = "requirement failed"
    ) -> Self: ...
    def tap(self, fn: Callable[[T], object]) -> Self: ...
    def inspect(self) -> _Graph: ...
    def explain(self) -> _Graph: ...
    def generate(
        self,
        *,
        context: BuildContext | None = ...,
        budget: Budget | None = ...,
        tokenizer: _TokenizerSpec | None = ...,
        options: BuildOptions | None = ...,
        telemetry: TelemetryConfig | None = ...,
    ) -> Generated[T]: ...
    def write(
        self,
        path: PathArgument,
        *,
        context: BuildContext | None = ...,
        budget: Budget | None = ...,
        tokenizer: _TokenizerSpec | None = ...,
        options: BuildOptions | None = ...,
        telemetry: TelemetryConfig | None = ...,
    ) -> Generated[T]: ...

class Literal(Source[bytes]):
    def __init__(self, value: bytes) -> None: ...
    def slice(
        self, start: int | None = ..., stop: int | None = ..., step: int | None = ...
    ) -> Literal: ...
    def concat(self, *parts: _BytesOperand) -> Literal: ...
    def replace_bytes(
        self, old: _BytesOperand, new: _BytesOperand, count: int = -1
    ) -> Literal: ...
    def starts_with(self, prefix: _BytesOperand) -> Source[bool]: ...
    def ends_with(self, suffix: _BytesOperand) -> Source[bool]: ...
    def base64(self) -> Text: ...
    def hex(self) -> Text: ...
    def sha256(self) -> Text: ...

class Text(Source[str]):
    def __init__(self, value: str) -> None: ...
    def concat(self, *parts: _TextOperand) -> Text: ...
    def join(self, parts: Iterable[_TextOperand]) -> Text: ...
    def strip(self, chars: _TextOperand | None = ...) -> Text: ...
    def lstrip(self, chars: _TextOperand | None = ...) -> Text: ...
    def rstrip(self, chars: _TextOperand | None = ...) -> Text: ...
    def replace(
        self, old: _TextOperand, new: _TextOperand, count: int = -1
    ) -> Text: ...
    def split(
        self, sep: _TextOperand | None = ..., maxsplit: int = -1
    ) -> Source[list[str]]: ...
    def slice(
        self, start: int | None = ..., stop: int | None = ..., step: int | None = ...
    ) -> Text: ...
    def indent(self, n: int) -> Text: ...
    def dedent(self) -> Text: ...
    def normalize_newlines(self, style: _Newline = "lf") -> Text: ...
    def format(self, *args: object, **kwargs: object) -> Text: ...
    def encode(self, encoding: str = "utf-8") -> Literal: ...

class MarkdownValue:
    @property
    def source(self) -> str: ...

class MD(Source[MarkdownValue]):
    def __init__(self, source: str) -> None: ...
    def section(self, heading: str, occurrence: int = 0) -> MD: ...
    def sections(self) -> Source[list[MarkdownSection]]: ...
    def headings(self) -> Source[list[MarkdownHeading]]: ...
    def shift_headings(self, levels: int) -> MD: ...
    def insert_before(
        self, heading: str, content: _MarkdownOperand, occurrence: int = 0
    ) -> MD: ...
    def insert_after(
        self, heading: str, content: _MarkdownOperand, occurrence: int = 0
    ) -> MD: ...
    def append(self, *content: _MarkdownOperand) -> MD: ...
    def prepend(self, *content: _MarkdownOperand) -> MD: ...
    def replace_section(
        self, heading: str, content: _MarkdownOperand, occurrence: int = 0
    ) -> MD: ...
    def remove_section(self, heading: str, occurrence: int = 0) -> MD: ...
    def links(self) -> Source[list[MarkdownLink]]: ...
    def render(self) -> Text: ...

class JSON(Source[JSONValue]):
    def __init__(self, value: str) -> None: ...
    @staticmethod
    def from_value(value: object) -> JSON: ...  # type: ignore[override]
    @overload
    def get(self, key: _JSONKey) -> JSON: ...
    @overload
    def get(self, key: _JSONKey, default: object, /) -> JSON: ...
    @overload
    def get_text(self, key: _JSONKey) -> Text: ...
    @overload
    def get_text(self, key: _JSONKey, default: _TextOperand, /) -> Text: ...
    def set(self, key: _JSONKey, value: object) -> JSON: ...
    def remove(self, key: _JSONKey) -> JSON: ...
    def merge(self, other: object, *, conflict: _Conflict = "right") -> JSON: ...
    def select(self, path: _SourceKey) -> JSON: ...
    def filter(self, predicate: Callable[[JSONValue], bool]) -> JSON: ...
    def append_array(self, *values: object) -> JSON: ...
    def sort_keys(self) -> JSON: ...
    def pretty(self, indent: int = 2) -> JSON: ...
    def minify(self) -> JSON: ...
    def to_toml(self) -> TOML: ...

class TOML(Source[TOMLTable]):
    def __init__(self, value: str) -> None: ...
    @staticmethod
    def from_value(value: _TOMLTableOperand) -> TOML: ...  # type: ignore[override]
    def table(self, key: _SourceKey) -> TOML: ...
    def root(self) -> TOML: ...
    @overload
    def get(self, key: _SourceKey) -> Source[TOMLValue]: ...
    @overload
    def get[U](
        self, key: _SourceKey, default: Source[U], /
    ) -> Source[TOMLValue | U]: ...
    @overload
    def get[U](self, key: _SourceKey, default: U, /) -> Source[TOMLValue | U]: ...
    def set(self, key: _SourceKey, value: object) -> TOML: ...
    def remove(self, key: _SourceKey) -> TOML: ...
    def rename(self, key: _SourceKey, new_key: _SourceKey) -> TOML: ...
    def merge(
        self, other: _TOMLTableOperand, *, conflict: _Conflict = "right"
    ) -> TOML: ...
    def keys(self) -> Source[list[str]]: ...
    @overload
    def arrays(self, key: None = ...) -> Source[list[list[TOMLValue]]]: ...
    @overload
    def arrays(self, key: _SourceKey) -> Source[list[TOMLValue]]: ...
    def to_json(self) -> JSON: ...

class XMLValue:
    @property
    def source(self) -> bytes: ...

class XML(Source[XMLValue]):
    def __init__(self, source: str | bytes) -> None: ...
    @staticmethod
    def element(
        name: str,
        *children: _XMLOperand,
        attrs: Mapping[str, _XMLOperand] | None = ...,
        **attributes: _XMLOperand,
    ) -> XML: ...
    def xpath(
        self, expression: str, namespaces: Mapping[str, str] | None = ...
    ) -> XML: ...
    def find(self, path: str, namespaces: Mapping[str, str] | None = ...) -> XML: ...
    def children(self, name: str | None = ...) -> XML: ...
    def text(self, separator: str = "") -> Text: ...
    def set_text(self, value: _XMLOperand) -> XML: ...
    def set_attr(self, name: str, value: _XMLOperand) -> XML: ...
    def remove_attr(self, name: str) -> XML: ...
    def append(self, *children: _XMLOperand) -> XML: ...
    def prepend(self, *children: _XMLOperand) -> XML: ...
    def replace(self, *contents: _XMLOperand) -> XML: ...
    def remove(
        self, path: str | None = ..., namespaces: Mapping[str, str] | None = ...
    ) -> XML: ...
    def wrap(self, name: str) -> XML: ...
    def unwrap(self) -> XML: ...
    def minify_whitespace(self, policy: str = "markup_only") -> XML: ...
    def serialize(self) -> Literal: ...

class Document(Source[bytes]):
    def __init__(
        self,
        format: _DocumentFormat = "text",
        separator: _DocumentPart | None = ...,
    ) -> None: ...
    def append(self, *parts: _DocumentPart) -> Document: ...
    def extend(self, parts: Iterable[_DocumentPart]) -> Document: ...
    def prepend(self, *parts: _DocumentPart) -> Document: ...
    def insert(self, index: int, part: _DocumentPart) -> Document: ...
    def remove(self, index: int) -> Document: ...
    def replace_part(self, index: int, part: _DocumentPart) -> Document: ...
    def slice_parts(
        self, start: int | None = ..., stop: int | None = ...
    ) -> Document: ...
    def concat(
        self, other: Document, separator: _DocumentPart | None = ...
    ) -> Document: ...
    def join(self, separator: _DocumentPart | None = ...) -> Document: ...
    def map_parts(self, fn: Callable[[Any], object]) -> Document: ...
    def filter_parts(self, pred: Callable[[Any], bool]) -> Document: ...
    def __add__(self, part: _DocumentPart) -> Document: ...
    def squish(self, mode: _SquishMode = "auto") -> Document: ...
    def replace(
        self, old: _DocumentPart, new: _DocumentPart, count: int = -1
    ) -> Document: ...
    def strip(self) -> Document: ...
    def indent(self, n: int) -> Document: ...
    def dedent(self) -> Document: ...
    def normalize_newlines(self, style: _Newline = "lf") -> Document: ...
    def wrap(self, prefix: _DocumentPart, suffix: _DocumentPart) -> Document: ...
    def ensure_prefix(self, prefix: _DocumentPart) -> Document: ...
    def ensure_suffix(self, suffix: _DocumentPart) -> Document: ...
    def budget(self, budget: Budget) -> Document: ...
    # The post stream accepts bytes transformations only.
    @overload  # type: ignore[override]
    def pipe(self, op: Callable[[bytes], bytes]) -> Document: ...
    @overload
    def pipe(
        self,
        op: Callable[Concatenate[bytes, ...], bytes],
        *args: object,
        **kwargs: object,
    ) -> Document: ...
    @overload
    def pipe(  # pyright: ignore[reportIncompatibleMethodOverride]
        self, op: str, *args: object, **kwargs: object
    ) -> Document: ...
    def op(self, name: str, *args: object, **kwargs: object) -> Document: ...

class Operation[T, **P, U, S: Source[Any]]:
    @property
    def name(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def pure(self) -> bool: ...
    @property
    def input(self) -> type[object]: ...
    @property
    def output(self) -> type[object]: ...
    @property
    def configuration(self) -> object: ...
    def __call__(self, value: T, /, *args: P.args, **kwargs: P.kwargs) -> U: ...

class _TypedDecorator[S: Source[Any]](Protocol):
    def __call__[T, **P, U](
        self, fn: Callable[Concatenate[T, P], U], /
    ) -> Operation[T, P, U, S]: ...

class _Decorator(Protocol):
    def __call__[T, **P, U](
        self, fn: Callable[Concatenate[T, P], U], /
    ) -> Operation[T, P, U, Source[U]]: ...

@overload
def operation[S: Source[Any]](
    *,
    input: type[object] = ...,
    output: type[S],
    pure: bool = True,
    version: str = "1",
    name: str | None = ...,
    configuration: object = ...,
) -> _TypedDecorator[S]: ...
@overload
def operation(
    *,
    input: type[object] = ...,
    output: type[object] = ...,
    pure: bool = True,
    version: str = "1",
    name: str | None = ...,
    configuration: object = ...,
) -> _Decorator: ...

class _OperationRegistry:
    def mount(
        self,
        input: type[object],
        name: str,
        op: Callable[..., object],
        *,
        overwrite: bool = False,
        scope: str = "global",
    ) -> None: ...
    def register_format[T](
        self,
        cls: type[Source[T]],
        parse: Parser[T],
        serialize: Serializer[T],
        validate: Validator[T] | None = ...,
    ) -> None: ...

ops: _OperationRegistry
